# --- Dependencies ---
node_modules/
backend/node_modules/
frontend/node_modules/

# --- Environment / secrets (never commit real values) ---
.env
.env.local
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# --- Runtime uploads (local dev storage, not source) ---
backend/uploads/*
!backend/uploads/.gitkeep

# --- Frontend build output ---
frontend/dist/
frontend/build/

# --- Logs ---
*.log
npm-debug.log*

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/
